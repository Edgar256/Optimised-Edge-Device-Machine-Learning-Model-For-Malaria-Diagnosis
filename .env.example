# Copy to .env and adjust values for your environment.
# Local dev example (MySQL on your machine):
DATABASE_URL=mysql://user:password@localhost:3306/malaria_prediction
# Render/production — CloudClusters (Cloudsters) example from provider docs:
#   mysql -h mysql-202816-0.cloudclusters.net -P 19889 -u admin -p<Password>
# Use the hostname, port, user, and password from YOUR CloudClusters dashboard (not localhost).
# URL-encode special characters in the password (@ → %40, # → %23).
# CloudClusters uses a self-signed SSL cert — use ssl_verify=false when ssl=true is required:
# DATABASE_URL=mysql://admin:YOUR_PASSWORD@mysql-202816-0.cloudclusters.net:19889/malaria_data_db?ssl=true&ssl_verify=false
API_URL=http://localhost:8000
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_REGISTRATION_SECRET=replace-with-a-long-admin-bootstrap-secret
