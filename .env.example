# Copy to .env and adjust values for your environment.
# Local dev example (MySQL on your machine):
DATABASE_URL=mysql://user:password@localhost:3306/malaria_prediction
# Render/production: use your hosted MySQL URL (PlanetScale, Aiven, Railway, etc.).
# Do NOT use localhost on Render. URL-encode special characters in the password.
# Example: mysql://admin:my%40pass@db.example.com:3306/malaria_prediction
API_URL=http://localhost:8000
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_REGISTRATION_SECRET=replace-with-a-long-admin-bootstrap-secret
