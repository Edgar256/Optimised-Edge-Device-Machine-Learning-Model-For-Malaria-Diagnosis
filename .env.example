# Copy to .env and adjust values for your environment.
# Local dev example (MySQL on your machine):
DATABASE_URL=mysql://user:password@localhost:3306/malaria_prediction
# Render/production — Aiven MySQL (provider may give ssl-mode=REQUIRED; that form is supported):
# DATABASE_URL=mysql://avnadmin:YOUR_PASSWORD@mysql-XXXX.aivencloud.com:16447/malaria_data_db?ssl-mode=REQUIRED
# Equivalent forms also work:
# DATABASE_URL=mysql://avnadmin:YOUR_PASSWORD@mysql-XXXX.aivencloud.com:16447/malaria_data_db?ssl=true
# URL-encode special characters in the password (@ → %40, # → %23).
# Self-signed hosts (some CloudClusters plans): add &ssl_verify=false
API_URL=http://localhost:8000
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_REGISTRATION_SECRET=replace-with-a-long-admin-bootstrap-secret
