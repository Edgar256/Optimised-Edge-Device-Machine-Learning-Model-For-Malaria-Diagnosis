# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
*.egg
.venv/
venv/
env/
.mplconfig/

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# ML artifacts (tracked structure, not binary outputs)
# results/ and reports/ are versioned for thesis reproducibility.
# TFLite releases under models/tflite/ are versioned for mobile OTA updates.
models/*
!models/.gitkeep
!models/tflite/
!models/tflite/**
figures/*
!figures/.gitkeep
data/processed/*
!data/processed/.gitkeep
catboost_info/

# IDE & OS
.idea/
.vscode/
.DS_Store
*.swp

# Testing & coverage
.pytest_cache/
.coverage
htmlcov/
.ruff_cache/

# Environment secrets
.env
.env.*
